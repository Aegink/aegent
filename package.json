{
  "name": "aegent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "description": "aegent 内核（P0）：事件源、权限、沙箱、上下文管理的最小闭环",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aegent": "dist/src/cli/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc && node scripts/copy-assets.mjs",
    "check": "tsc --noEmit",
    "build:sandbox-helper": "cd src/sandbox/win32-helper && cargo build --release",
    "doctor": "npm run build && node dist/src/cli/doctor.js",
    "maintenance": "npm run build && node dist/src/cli/maintenance.js",
    "architecture:check": "node tools/architecture-check.mjs",
    "vocabulary:check": "node tools/vocabulary-check.mjs",
    "sandbox:provision": "npm run build && node dist/src/cli/provision.js",
    "mock:llm": "npm run build && node dist/src/cli/mock-llm-run.js",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "architecture:read": "node tools/architecture-read.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
