{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aegent",
  "version": "0.1.0",
  "identifier": "io.github.wangh.aegent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aegent",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "pip",
        "title": "aegent 画中画",
        "width": 320,
        "height": 240,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "url": "pip.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/portable/host.cjs": "host.cjs",
      "../dist/portable/agent-child.cjs": "agent-child.cjs",
      "../dist/portable/node.exe": "node.exe",
      "../dist/portable/schema.sql": "schema.sql",
      "../dist/portable/ui/": "ui/",
      "../dist/portable/node_modules/": "node_modules/",
      "../dist/portable/descriptions/": "descriptions/",
      "../dist/portable/templates/": "templates/",
      "../dist/portable/prompt/": "prompt/",
      "../dist/portable/dpapi/": "dpapi/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMDU2QkVGQkFFMkNENkQKUldSdHplSzY3MnNGYnJnLzRLYlNVSEk4Q2QrMXVKeHRHaEV4VUg4OVdFM3FhaWNvU1VxSzZtREEK",
      "endpoints": [
        "http://127.0.0.1:8789/valid/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
