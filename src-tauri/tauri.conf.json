{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aegent",
  "version": "0.1.0",
  "identifier": "io.github.wangh.aegent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aegent",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      },
      {
        "label": "pip",
        "title": "aegent 画中画",
        "width": 320,
        "height": 240,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "url": "pip.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
